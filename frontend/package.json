{
  "name": "cogniforge-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node server.js",
    "dev:next": "next dev --hostname 0.0.0.0 --port 5000",
    "build": "next build",
    "start": "node server.js",
    "lint": "npx eslint@8 app/ --ext .js,.jsx",
    "//typecheck": "D-185: TypeScript يُجلَب عند الطلب (npx) ولا يُضاف كتبعية، فيبقى package-lock.json ثابتاً بايتاً ببايت ولا يمكن أن ينحرف npm ci. والملف tsconfig.check.json مُسمّى هكذا عمداً كي لا يُفعِّل Next.js مسار TypeScript في next build (الذي يشترط الحزم فعلياً).",
    "typecheck": "npx -y -p typescript@5.6.3 tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "http-proxy": "^1.18.1",
    "katex": "^0.18.4",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1"
  }
}
