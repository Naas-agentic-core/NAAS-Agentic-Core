# =============================================================================
# .env.example — variables consumed by docker-compose.yml (the Docker full stack)
# =============================================================================
# Copy to .env and fill in real values, OR (preferred) let the automatic bridge
# generate .env from Codespaces Secrets / process env / .devcontainer/secrets.env:
#
#     bash scripts/compose_env_from_secrets.sh
#     docker compose up --build
#
# .env is git-ignored. This stack is SELF-CONTAINED — it uses LOCAL Postgres and
# Redis containers, NOT Supabase. Do not put a Supabase DATABASE_URL here; each
# service builds its own DB URL from POSTGRES_USER/POSTGRES_PASSWORD internally.
# =============================================================================

# ── LLM (required for real answers — the R0.1 "no mock" gate) ────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Provider base URL — declared ONCE, as a field in each brain's `Settings`
# (app/core/settings/base.py and microservices/orchestrator_service/src/core/config.py),
# then read by the provider clients (orchestrator LLM client + both `simple_client`
# gateways + the DSPy node). Point it at a proxy or a test double; leave unset for
# https://openrouter.ai/api/v1. One home for the name — not five os.getenv calls:
# `check_no_magic_strings.py` (D-270 L5) reddens duplicated identifiers. (D-288)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The model chain lives in ONE place: `shared/ai_models/model_chain.py` — PRIMARY
# `google/gemma-4-31b-it:free` + alive fallbacks, mirrored by both brains under a
# parity gate. `OPENROUTER_PRIMARY_MODEL` overrides PRIMARY at runtime; use it only to
# pin a model you have seen served, never to hide a dead one — a green job that overrides
# a broken chain measures nothing. Ask the live registry before you blame the code:
# `make model-check` (or `python scripts/verify_model_registry_live.py`).

# ── Web search (optional — research-agent degrades gracefully without it) ─────
# Accepts either a bare `tvly-...` key OR the Tavily MCP URL form
# (https://mcp.tavily.com/mcp/?tavilyApiKey=tvly-...); the bridge sanitizes it.
TAVILY_API_KEY=tvly-dev-your-key-here

# ── Shared JWT secret across gateway + all agents (must match) ───────────────
SECRET_KEY=change-me-to-a-32+char-random-secret

# ── Local Postgres containers (self-contained — safe to keep defaults) ───────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# ── Grafana admin password (observability UI on :3001) ───────────────────────
GRAFANA_ADMIN_PASSWORD=admin
