# =============================================================================
# Protocol V24.0 — Codespaces DevOps Stack environment template
# =============================================================================
# Copy this file to `.env.codespaces` and fill in real values, then run:
#
#   docker compose -f docker-compose.codespaces.yml --env-file .env.codespaces up --build
#
# DO NOT commit the filled-in `.env.codespaces` (it is gitignored). Only this
# `.example` template is tracked.
# =============================================================================

# --- Database (Supabase pooler — transaction mode on 6543) -------------------
# psycopg2/asyncpg both accept the libpq URI form. Keep ?sslmode=require.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?sslmode=require
# Optional explicit override (takes priority in app/core/settings/base.py).
# APP_DATABASE_URL=

# --- LLM provider (OpenRouter) -----------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Base URL of the provider — every client honours it (orchestrator LLM client, both
# `simple_client` gateways, research `super_search`). Point it at a proxy or a test
# double; leave unset for https://openrouter.ai/api/v1.  (D-288)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The model chain lives in ONE place: `shared/ai_models/model_chain.py` — PRIMARY
# `google/gemma-4-31b-it:free` + alive fallbacks, mirrored by both brains under a
# parity gate. `OPENROUTER_PRIMARY_MODEL` overrides PRIMARY at runtime; use it only to
# pin a model you have seen served, never to hide a dead one — a green job that overrides
# a broken chain measures nothing. Ask the live registry before you blame the code:
# `make model-check` (or `python scripts/verify_model_registry_live.py`).

# --- Web search (Tavily) — key must start with tvly- -------------------------
TAVILY_API_KEY=tvly-dev-your-key-here

# --- Ambient cognitive identity (Honcho — D-269) -----------------------------
# Optional. This stack runs the monolith (`uvicorn app.main:app`), which is the
# only consumer. Capture + liveness probe only — NO student data leaves the
# platform in this phase (§0.21; the write path is a declared SEAM, zero code).
HONCHO_API_KEY=hch-v3-your-key-here

# --- Auth / runtime ----------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-secret
ENVIRONMENT=development
NODE_ENV=development

# --- Optional Supabase metadata ----------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ROLE_KEY=
