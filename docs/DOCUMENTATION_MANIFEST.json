{
  "$schema_version": "1",
  "purpose": "Machine-readable manifest for current, operational documentation.",
  "source_of_truth": "docs/DOCUMENTATION_CONTRACT.md",
  "scan_globs": [
    "**/*.md",
    "README.md",
    "README.ar.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "CLAUDE.md",
    "SAFEGUARDING.md",
    "DATA_POLICY.md",
    "SECURITY.md",
    "GOVERNANCE.md",
    "CODE_OF_CONDUCT.md",
    "docs/**/*.md",
    "app/**/README.md",
    "microservices/**/README.md",
    "scripts/README.md",
    ".devcontainer/README.md",
    ".devcontainer/CHANGELOG.md",
    ".github/VERIFICATION_CHECKLIST.md",
    ".memory/**/*.md",
    ".claude/**/*.md",
    ".github/**/*.md"
  ],
  "exclude_globs": [
    "docs/archive/**",
    ".pytest_cache/**"
  ],
  "documents": [
